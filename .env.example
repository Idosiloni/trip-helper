# Supabase project (Settings → API). The publishable key is safe in the browser;
# RLS is what protects the data. Never put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Only for tests/rls (two throwaway test users). Server-side only, never NEXT_PUBLIC.
SUPABASE_SECRET_KEY=

# Web Push public key (the private key lives in Supabase secrets)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
