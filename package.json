    "motion": "14.14.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
